# ── Frontend environment variables ────────────────────────────────────────────
# Copy this file to .env.local for local development or set in Vercel dashboard.

# Base URL of the backend API (Render service URL in production)
VITE_API_BASE_URL=https://your-backend.onrender.com

# Supabase project credentials (anon / public key — safe to expose in browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
