# OmniSight backend environment — PLACEHOLDERS ONLY.
# Copy to `.env` and fill in locally. Never commit real secrets.

# ── Environment mode ──────────────────────────────────────────────────────────
# "production" enforces strict SSRF / target policies and requires real keys.
# Use "development" locally.
OMNISIGHT_ENV=development

OMNISIGHT_APP_NAME=OmniSight Backend
OMNISIGHT_DEBUG=false
OMNISIGHT_LOG_LEVEL=INFO

# Comma-separated CORS allow-list (React dev server origins).
# In production set to your Vercel URL(s); the *.vercel.app wildcard is always
# applied automatically by main.py so preview deployments work too.
OMNISIGHT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local directories for evidence artifacts and data files.
# In production / Render, use ephemeral /tmp paths.
OMNISIGHT_ARTIFACTS_DIR=artifacts
OMNISIGHT_DATA_DIR=data

# Optional shared secret used to verify CI/CD webhook calls (leave blank in dev).
# When blank the receiver is UNAUTHENTICATED — acceptable for the local
# simulation only; a startup warning is logged.
OMNISIGHT_CI_WEBHOOK_SECRET=

# CI webhook hardening.
OMNISIGHT_WEBHOOK_MAX_BODY_BYTES=65536
# Optional comma-separated allow-list of target hosts for successful builds
# (empty = permissive; local simulation only).
OMNISIGHT_TARGET_HOST_ALLOWLIST=

# Scan limits.
OMNISIGHT_MAX_SCAN_URL_LENGTH=2048
OMNISIGHT_SCAN_CREATE_RATE_LIMIT_PER_MINUTE=60

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL is the source of truth. Supabase issues postgres:// URLs — these
# are automatically rewritten to postgresql+psycopg:// by db.py.
OMNISIGHT_DATABASE_URL=postgresql+psycopg://omnisight:CHANGE_ME@127.0.0.1:5432/omnisight

# ── Supabase ──────────────────────────────────────────────────────────────────
OMNISIGHT_SUPABASE_URL=https://your-project.supabase.co
OMNISIGHT_SUPABASE_ANON_KEY=
OMNISIGHT_SUPABASE_SERVICE_ROLE_KEY=
OMNISIGHT_SUPABASE_STORAGE_BUCKET=scan-artifacts
OMNISIGHT_ARTIFACT_MAX_IMAGE_BYTES=5242880
OMNISIGHT_ARTIFACT_MAX_JSON_BYTES=1048576

# ── Feature flags ─────────────────────────────────────────────────────────────
# Default to true in this file; set to false in local dev if modules not ready.
OMNISIGHT_ENABLE_PLAYWRIGHT_WORKER=true
OMNISIGHT_ENABLE_VLM_DETECTION=true
OMNISIGHT_ENABLE_PATCH_ENGINE=true

# ── GitHub App integration ────────────────────────────────────────────────────
# Generate a private key from the GitHub App settings; keep it server-side.
# On Render, provide OMNISIGHT_GITHUB_APP_PRIVATE_KEY as a single-line PEM
# with \n between lines (db.py / github_app.py auto-unescapes them).
OMNISIGHT_ENABLE_GITHUB_APP=true
OMNISIGHT_ENABLE_GITHUB_PUBLISH_API=true
OMNISIGHT_GITHUB_APP_ID=
OMNISIGHT_GITHUB_APP_INSTALLATION_ID=
OMNISIGHT_GITHUB_APP_PRIVATE_KEY=
OMNISIGHT_GITHUB_WEBHOOK_SECRET=
OMNISIGHT_ENABLE_GITHUB_DELIVERY=true
OMNISIGHT_GITHUB_DRY_RUN=false
OMNISIGHT_GITHUB_TARGET_OWNER=
OMNISIGHT_GITHUB_TARGET_REPOSITORY=
OMNISIGHT_GITHUB_TARGET_BRANCH=main

# ── Auth ──────────────────────────────────────────────────────────────────────
OMNISIGHT_AUTH_MODE=supabase
OMNISIGHT_LOCAL_AUTH_TOKEN=
OMNISIGHT_LOCAL_PROJECT_ID=b13a29c2-4669-5ac7-9ba6-ff7c1d32ae11
OMNISIGHT_LOCAL_PROJECT_NAME=OmniSight

# ── VLM adapter ───────────────────────────────────────────────────────────────
# "gemini" in production. "mock" for local dev (no API key needed).
OMNISIGHT_VLM_ADAPTER=gemini
OMNISIGHT_VLM_PROVIDER=gemini
OMNISIGHT_VLM_MOCK_SCENARIO=clipped_button
OMNISIGHT_VLM_TIMEOUT_SECONDS=30
OMNISIGHT_VLM_MAX_IMAGE_BYTES=5242880
OMNISIGHT_VLM_MAX_IMAGES_PER_ANALYSIS=6

# ── Gemini API ────────────────────────────────────────────────────────────────
OMNISIGHT_GEMINI_API_KEY=
OMNISIGHT_GEMINI_MODEL=gemini-1.5-flash
OMNISIGHT_GEMINI_TIMEOUT_SECONDS=30
OMNISIGHT_GEMINI_MAX_OUTPUT_TOKENS=4096

# ── AI gateway ────────────────────────────────────────────────────────────────
OMNISIGHT_AI_MAX_REPAIR_ATTEMPTS=1
OMNISIGHT_AI_MAX_OUTPUT_TOKENS=4096
OMNISIGHT_AI_MAX_FINDINGS=20
OMNISIGHT_AI_ALLOW_RAW_OUTPUT_STORAGE=false

# ── Detection ────────────────────────────────────────────────────────────────
OMNISIGHT_DETECTION_MAX_CANDIDATES=50
OMNISIGHT_DETECTION_MAX_RAW_OUTPUT_BYTES=8192
OMNISIGHT_DETECTION_EXPOSE_RAW_OUTPUT=false

# ── Patch engine ──────────────────────────────────────────────────────────────
OMNISIGHT_PATCH_GENERATOR=gemini
OMNISIGHT_PATCH_MOCK_SCENARIO=ok
OMNISIGHT_APPROVED_PATCH_PATHS=**/*.css,**/*.scss,**/*.jsx,**/*.tsx
OMNISIGHT_PATCH_ALLOWED_EXTENSIONS=.css,.scss,.jsx,.tsx
OMNISIGHT_PATCH_SOURCE_ROOT=
OMNISIGHT_MAX_PATCH_FILES=5
OMNISIGHT_MAX_PATCH_BYTES=4096
OMNISIGHT_PATCH_CONTEXT_MAX_BYTES=4096
OMNISIGHT_PATCH_MAX_RESPONSE_BYTES=16384

# ── Repair orchestrator ───────────────────────────────────────────────────────
OMNISIGHT_ENABLE_REPAIR_ORCHESTRATOR=true
OMNISIGHT_MAX_REPAIR_ATTEMPTS=3

# ── Workspace (ephemeral on Render, persistent locally) ───────────────────────
OMNISIGHT_WORKSPACE_ROOT=/tmp/omnisight-workspaces

# ── Multi-provider VLM fallbacks ──────────────────────────────────────────────
OMNISIGHT_OPENAI_API_KEY=
OMNISIGHT_OPENAI_MODEL=gpt-4o-mini
OMNISIGHT_ANTHROPIC_API_KEY=
OMNISIGHT_ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OMNISIGHT_GROK_API_KEY=
OMNISIGHT_GROK_MODEL=grok-2-vision-latest

# ── VLM verifier ─────────────────────────────────────────────────────────────
OMNISIGHT_VLM_VERIFIER=gemini

# ── ShopLite sandbox (dev-only, disabled in production) ───────────────────────
OMNISIGHT_ENABLE_SHOPLITE_SANDBOX=false
OMNISIGHT_SHOPLITE_SANDBOX_TOKEN=
OMNISIGHT_SHOPLITE_SANDBOX_TIMEOUT_SECONDS=45
